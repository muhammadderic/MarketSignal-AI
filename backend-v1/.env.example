

# MarketSignal AI Environment Configuration Example
# Copy to `.env` and fill in real values before running the backend.
# Never commit a populated `.env` file to version control.

APP_NAME=Your App Name
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# REQUIRED: Groq LLM API key (obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Local SQLite database (async SQLAlchemy URL). Filename must match .gitignore.
DATABASE_URL=sqlite+aiosqlite:///./data/marketsignal.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Uvicorn bind settings (loopback only for single-user local runtime)
HOST=127.0.0.1
PORT=8000

# Deployment label: development | production
ENVIRONMENT=development